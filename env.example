# Netlify Functions scope. Values stay in Netlify, never in this file.
# Required: no implicit environment selection. Live = production.
PADDLE_ENV=production
PADDLE_API_KEY=
# Public browser token from the same LIVE account; must start with live_.
PADDLE_CLIENT_TOKEN=
# Events > Notifications > Lumira destination > Secret key (not the API key).
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
# Existing Firebase service-account JSON; keep its full value private.
FIREBASE_SERVICE_ACCOUNT_JSON=
