{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "leaderboard": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "totalSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() >= data.val())"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && (root.child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() >= data.val())"
        },
        "lastFlushAttempt": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "progress": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "meta": {
          "xp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() >= data.val())"
          },
          "supportGrants": {
            "$amount": {
              ".validate": "newData.isBoolean() && (root.child('admins').child(auth.uid).val() === true || newData.val() === data.val())"
            }
          }
        }
      }
    },
    "banned": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      ".write": "root.child('admins').child(auth.uid).val() === true"
    },
    "analytics": {
      ".read": "root.child('admins').child(auth.uid).val() === true",
      "events": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$event": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      },
      "dau": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$user": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      },
      "funnel": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$step": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      },
      "sessions": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$field": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      }
    },
    "system": {
      "signupCount": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
