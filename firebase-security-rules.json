{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "leaderboard": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "totalSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() >= data.val())"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000 && (root.child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() >= data.val())"
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "lastFlushAttempt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "newData.isNumber() || newData.isBoolean() || (newData.isString() && newData.val().length <= 100)"
        }
      }
    },
    "progress": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "meta": {
          "xp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() >= data.val())"
          },
          "supportGrants": {
            "$amount": {
              ".validate": "newData.isBoolean() && (root.child('admins').child(auth.uid).val() === true || newData.val() === data.val())"
            }
          }
        }
      }
    },
    "banned": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "analytics": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "events": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$event": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && (data.isNumber() ? newData.val() >= data.val() && newData.val() <= data.val() + 1000 : newData.val() >= 0 && newData.val() <= 1000)"
          }
        }
      },
      "dau": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$user": {
            ".write": "auth != null && auth.uid === $user",
            ".validate": "newData.isNumber() && newData.val() === 1"
          }
        }
      },
      "funnel": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$step": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && (data.isNumber() ? newData.val() >= data.val() && newData.val() <= data.val() + 1000 : newData.val() >= 0 && newData.val() <= 1000)"
          }
        }
      },
      "sessions": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$field": {
            ".write": "auth != null",
            ".validate": "($field === 'n' || $field === 'totalSec') && newData.isNumber() && (data.isNumber() ? newData.val() >= data.val() && newData.val() <= data.val() + 30000 : newData.val() >= 0 && newData.val() <= 30000)"
          }
        }
      }
    },
    "system": {
      "signupCount": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isNumber() && newData.val() === (data.isNumber() ? data.val() : 0) + 1"
      }
    },
    "serverAnnouncements": {
      "broadcast": {
        ".indexOn": ["createdAt"]
      },
      "users": {
        "$uid": {
          ".indexOn": ["createdAt"]
        }
      }
    },
    "serverAnnouncementAudit": {
      ".indexOn": ["createdAt"]
    }
  }
}
